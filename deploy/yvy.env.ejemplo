# Configuración del servidor de Yvy Guaraní en producción (se copia a /etc/yvy/yvy.env).
# La aplicación escucha solo en la máquina; Caddy la publica con https.
PORT=4173
HOST=127.0.0.1
DATA_DIR=/var/lib/yvy
# Hay https delante (Caddy): cookie Secure y HSTS.
COOKIE_SECURE=1
# Caddy agrega la IP real del cliente en X-Forwarded-For.
TRUST_PROXY=1
